# 个学（GeXue）版本管理忽略规则

# ---------- 环境变量（含密钥，绝不提交） ----------
.env
.env.*
!.env.example

# ---------- 需求/技术方案文档（内部设计，不纳入版本管理） ----------
docs/

# ---------- Go 构建产物 ----------
/bin/
*.exe
*.test
*.out
coverage.*

# ---------- 前端（如后续纳入本仓库） ----------
node_modules/
dist/
*.local

# ---------- IDE / 编辑器配置 ----------
.idea/
*.iml
*.xml
projectFilesBackup*/

# ---------- 其他 ----------
about-me.md

# ---------- 系统 / 日志 ----------
.DS_Store
*.log
