# ============================================
# 个学 (GeXue) 环境配置模板
# 复制为 .env 并填入真实值（变量名与 ~/ww/mianba/backend 对齐）
# cp .env.example .env
# ============================================

# ---------- 大模型（复用 mianba 配置） ----------
ARK_API_KEY=            # 火山方舟（DeepSeek/doubao 出题·追问·判分）
DASHSCOPE_API_KEY=      # 阿里云 DashScope（text-embedding-v3 向量化 + qwen3-rerank 精排）
DEEPSEEK_V4_API_KEY=    # DeepSeek V4 直连（推理/流式备用）

# ---------- 精排（可选，默认复用 DASHSCOPE_API_KEY） ----------
# RERANK_ENABLED=true
# RERANK_MODEL=qwen3-rerank
# RERANK_API_KEY=
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_TOP_N=20

# ---------- 认证 ----------
JWT_SECRET_KEY=         # 与 mianba JWT_SECRET_KEY 同源即可

# ---------- 数据库（可选覆盖） ----------
DB_DSN=postgres://gexue:gexue@localhost:5432/gexue?sslmode=disable
